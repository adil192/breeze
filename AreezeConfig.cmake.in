@PACKAGE_INIT@

set(AREEZE_WITH_KDECORATION @WITH_DECORATIONS@)
if(${AREEZE_WITH_KDECORATION})
    set(AREEZE_KDECORATION_PLUGIN_ID "org.kde.areeze")
else()
    set(AREEZE_KDECORATION_PLUGIN_ID "")
endif()

set(AREEZE_STYLE_NAME "areeze")
set(AREEZE_COLOR_INSTALL_ROOT "@PACKAGE_KDE_INSTALL_FULL_DATADIR@/color-schemes/")
